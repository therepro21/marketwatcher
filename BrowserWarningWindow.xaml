<Window x:Class="MarketWatcher.BrowserWarningWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MarketWatcher – Eingabe erforderlich" Width="560" Height="310" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Topmost="True" Background="#210D12">
 <Border Margin="18" Padding="22" CornerRadius="12" Background="#48151F" BorderBrush="#FF526B" BorderThickness="2"><StackPanel>
  <TextBlock Text="⚠ Browser-Prüfung erkannt" Foreground="#FF8293" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="SearchText" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock x:Name="DetailText" Foreground="#FFD9DE" TextWrapping="Wrap"/>
  <TextBlock Text="Die Suche wurde sicherheitshalber pausiert. Öffne Edge, löse CAPTCHA bzw. Cookie-Abfrage und schließe Edge vollständig. Danach kannst du die Suche in MarketWatcher fortsetzen." Foreground="#FFD9DE" TextWrapping="Wrap" Margin="0,12,0,16"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Später" Click="Later_Click" Padding="16,9" Margin="4" Background="#6D3440" Foreground="White" BorderThickness="0"/><Button Content="Jetzt in Edge beheben" Click="Open_Click" Padding="16,9" Margin="4" Background="#E33E59" Foreground="White" BorderThickness="0"/></StackPanel>
 </StackPanel></Border>
</Window>
