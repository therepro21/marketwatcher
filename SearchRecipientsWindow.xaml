<Window x:Class="MarketWatcher.SearchRecipientsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Empfänger zuordnen" Height="520" Width="520" WindowStartupLocation="CenterOwner" Background="#0B1020">
 <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0FF"/></Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF0FF"/><Setter Property="Margin" Value="4"/></Style><Style TargetType="Button"><Setter Property="Background" Value="#5468FF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/></Style></Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Empfänger dieser Suche" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SearchName" Foreground="#93A4BF" Margin="0,4,0,14"/></StackPanel><TabControl Grid.Row="1" Background="#141B2D"><TabItem Header="WhatsApp"><ListBox x:Name="WhatsAppList" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay}"><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Number}" Foreground="#93A4BF" FontSize="11"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem><TabItem Header="Telegram"><ListBox x:Name="TelegramList" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay}"><StackPanel><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding ChatId}" Foreground="#93A4BF" FontSize="11"/></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem></TabControl><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Speichern" Click="Save_Click"/><Button Content="Abbrechen" Click="Cancel_Click" Background="#263451"/></StackPanel></Grid>
</Window>
