<Window x:Class="MarketWatcher.EmailSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Einstellungen" Icon="Assets/marktwachter.ico" Height="680" Width="700" WindowStartupLocation="CenterOwner" Background="#0B1020">
 <Window.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0FF"/></Style><Style TargetType="TextBox"><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="PasswordBox"><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="Padding" Value="8"/></Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF0FF"/><Setter Property="Margin" Value="0,4,0,12"/></Style><Style TargetType="Button"><Setter Property="Background" Value="#5468FF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/></Style></Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Einstellungen" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,14"/><TabControl Grid.Row="1" Background="#141B2D">
  <TabItem Header="Allgemein"><StackPanel Margin="20"><TextBlock Text="STARTVERHALTEN" Foreground="#93A4BF" FontWeight="SemiBold"/><CheckBox x:Name="SettingsAutoStart" Content="Mit Windows starten und nur im Infobereich anzeigen"/><TextBlock Text="Edge wird nur während einer Prüfung oder eines WhatsApp-Web-Versands geöffnet und danach geschlossen. Der Zeitplan schläft bis zum nächsten fälligen Lauf." Foreground="#93A4BF" TextWrapping="Wrap"/></StackPanel></TabItem>
  <TabItem Header="E-Mail"><StackPanel Margin="20"><TextBlock Text="SMTP-Server"/><TextBox x:Name="HostBox"/><TextBlock Text="Port"/><TextBox x:Name="PortBox"/><TextBlock Text="Gmail-Adresse / Benutzer"/><TextBox x:Name="UserBox"/><TextBlock Text="Empfänger"/><TextBox x:Name="RecipientBox"/><TextBlock Text="Google-App-Passwort"/><PasswordBox x:Name="PasswordBox"/></StackPanel></TabItem>
  <TabItem Header="Telegram"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><CheckBox x:Name="TelegramEnabled" Content="Telegram aktivieren"/><StackPanel Grid.Row="1"><TextBlock Text="Bot-Token von @BotFather"/><PasswordBox x:Name="TelegramTokenBox"/></StackPanel><DataGrid Grid.Row="2" x:Name="TelegramGrid" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled}" Width="55"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Chat-ID" Binding="{Binding ChatId}" Width="180"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3" Orientation="Horizontal"><Button Content="+ Empfänger" Click="AddTelegram_Click"/><Button Content="Entfernen" Click="RemoveTelegram_Click" Background="#71364A"/><Button Content="Testen" Click="TelegramTest_Click"/></StackPanel></Grid></TabItem>
  <TabItem Header="WhatsApp"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><CheckBox x:Name="WhatsAppEnabled" Content="WhatsApp Web aktivieren"/><DataGrid Grid.Row="1" x:Name="WhatsAppGrid" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled}" Width="55"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Telefonnummer mit Landesvorwahl" Binding="{Binding Number}" Width="230"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="+ Empfänger" Click="AddWhatsApp_Click"/><Button Content="Entfernen" Click="RemoveWhatsApp_Click" Background="#71364A"/><Button Content="Testnachricht" Click="WhatsAppTest_Click"/></StackPanel><Border Grid.Row="3" Background="#0E1526" CornerRadius="8" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="WhatsApp-Web-Anmeldung" FontWeight="SemiBold"/><TextBlock Text="Bei abgelaufener Sitzung QR-Code öffnen, mit dem Handy scannen und Edge danach schließen." Foreground="#93A4BF" TextWrapping="Wrap"/><Button Content="QR-Code / Anmeldung öffnen" Click="WhatsAppLogin_Click" HorizontalAlignment="Left"/></StackPanel></Border></Grid></TabItem>
 </TabControl><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Speichern" Click="Save_Click"/><Button Content="Abbrechen" Click="Cancel_Click" Background="#263451"/></StackPanel></Grid>
</Window>
