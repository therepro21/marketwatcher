<Window x:Class="MarketWatcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MarketWatcher" Height="900" Width="1540" MinHeight="760" MinWidth="1180" WindowStartupLocation="CenterScreen" Background="#0B111B" FontFamily="Segoe UI Variable Text,Segoe UI">
 <Window.Resources>
  <SolidColorBrush x:Key="Surface" Color="#121C29"/><SolidColorBrush x:Key="Surface2" Color="#182432"/><SolidColorBrush x:Key="Stroke" Color="#2B3B4E"/><SolidColorBrush x:Key="Muted" Color="#91A2B9"/><SolidColorBrush x:Key="Blue" Color="#347EF5"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F5FB"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1520"/><Setter Property="Foreground" Value="#F1F5FB"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#31445B"/><Setter Property="Padding" Value="12,9"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#0D1520"/><Setter Property="Foreground" Value="#F1F5FB"/><Setter Property="BorderBrush" Value="#31445B"/><Setter Property="Padding" Value="9"/></Style>
  <Style x:Key="RoundedButton" TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#1C2939"/><Setter Property="BorderBrush" Value="#35475C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#263A50"/><Setter TargetName="B" Property="BorderBrush" Value="#4D6A89"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}"><Setter Property="Background" Value="#347EF5"/><Setter Property="BorderBrush" Value="#4C91FF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="17"/></Style>
  <Style x:Key="NavButton" TargetType="Button"><Setter Property="Foreground" Value="#BDCADB"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="17,14"/><Setter Property="Margin" Value="8,3"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="N" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="N" Property="Background" Value="#1B2C43"/><Setter Property="Foreground" Value="#6AA5FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ToggleSwitch" TargetType="CheckBox"><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid Width="57" Height="30"><Border x:Name="Track" Background="#526177" CornerRadius="15"/><Ellipse x:Name="Thumb" Width="24" Height="24" Fill="#F6F8FB" HorizontalAlignment="Left" Margin="3,0,0,0"><Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.35"/></Ellipse.Effect></Ellipse></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#347EF5"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DarkMenuItem" TargetType="MenuItem"><Setter Property="Foreground" Value="#E5EDF8"/><Setter Property="Padding" Value="14,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Item" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="3,2"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#2A4160"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="DarkMenu" TargetType="ContextMenu"><Setter Property="ItemContainerStyle" Value="{StaticResource DarkMenuItem}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Background="#182432" BorderBrush="#405570" BorderThickness="1" CornerRadius="10" Padding="5"><StackPanel IsItemsHost="True"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101927" BorderBrush="#263548" BorderThickness="0,0,1,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid x:Name="SidebarHeader" Margin="14,18,10,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel x:Name="BrandPanel" Orientation="Horizontal"><Border Width="52" Height="52" CornerRadius="13" Background="#172438" Padding="5"><Image x:Name="SidebarLogo" Stretch="Uniform"/></Border><StackPanel Margin="12,5,0,0"><TextBlock Text="MarketWatcher" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Deals finden. Zeit sparen." Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></StackPanel><Button Grid.Column="1" x:Name="CollapseButton" Content="‹" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="18" Click="CollapseSidebar_Click" ToolTip="Navigation einklappen"/></Grid>
   <StackPanel Grid.Row="1"><Button Style="{StaticResource NavButton}" Background="#203352" Foreground="#67A3FF" Click="Overview_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="24" Width="38" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}"/><TextBlock x:Name="OverviewNavText" Text="Übersicht" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Click="Searches_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="24" Width="38"/><TextBlock x:Name="SearchesNavText" Text="Suchen" FontSize="14" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Click="Recipients_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="♙" FontSize="22" Width="38"/><TextBlock x:Name="RecipientsNavText" Text="Empfänger" FontSize="14" VerticalAlignment="Center"/></StackPanel></Button><Button Style="{StaticResource NavButton}" Click="Email_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="21" Width="38"/><TextBlock x:Name="SettingsNavText" Text="Einstellungen" FontSize="14" VerticalAlignment="Center"/></StackPanel></Button></StackPanel>
   <StackPanel Grid.Row="2" Margin="20,12,20,22"><Border x:Name="SidebarStatusBadge" Background="#112D27" CornerRadius="10" Padding="11"><StackPanel x:Name="SidebarStatusContent" Orientation="Horizontal"><Ellipse x:Name="SidebarStatusDot" Width="10" Height="10" Fill="#35DC83" Margin="0,0,9,0"/><TextBlock x:Name="SidebarAgentText" Text="Agent läuft" Foreground="#63E79C"/></StackPanel></Border><TextBlock x:Name="SidebarVersionText" Text="MarketWatcher · lokal" Foreground="{StaticResource Muted}" FontSize="10" Margin="3,11,0,0"/><TextBlock x:Name="CopyrightText" Text="© Michael P. Thiess" Foreground="#74869D" FontSize="10" Margin="3,5,0,0"/><TextBlock x:Name="GithubText" FontSize="10" Margin="3,3,0,0"><Hyperlink NavigateUri="https://github.com/therepro21/marketwatcher" RequestNavigate="PlatformLink_Click">GitHub · MarketWatcher</Hyperlink></TextBlock></StackPanel>
  </Grid></Border>

  <Grid Grid.Column="1" Margin="24,20,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="175"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Image x:Name="HeaderLogo" Width="64" Height="64" Margin="0,0,16,0" Visibility="Collapsed"/><StackPanel><TextBlock Text="MarketWatcher" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Deine automatisierten Marktsuchen im Überblick." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="＋  Neue Suche hinzufügen" Style="{StaticResource PrimaryButton}" Padding="22,13" Margin="0,0,10,0" Click="ShowNewSearch_Click"/><Button Content="⚙  Einstellungen" Style="{StaticResource RoundedButton}" Padding="20,13" Click="Email_Click"/></StackPanel></Grid>
   <Grid Grid.Row="1" Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="11" Padding="17" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Border Width="43" Height="43" Background="#15352E" CornerRadius="10"><Ellipse Width="13" Height="13" Fill="#39DE84" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="Agent läuft" Foreground="#5DE994" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="AgentStatus" Text="Agent wird gestartet" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></StackPanel></Border><Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="11" Padding="17" Margin="8,0"><StackPanel Orientation="Horizontal"><Border Width="43" Height="43" Background="#1A2A42" CornerRadius="10"><TextBlock Text="◷" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="Nächste Prüfung" Foreground="#B7C5D8" FontWeight="SemiBold"/><TextBlock x:Name="NextCheckText" Text="Wird berechnet …" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></StackPanel></Border><Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="11" Padding="17" Margin="8,0,0,0"><StackPanel Orientation="Horizontal"><Border Width="43" Height="43" Background="#1A2A42" CornerRadius="10"><Viewbox Width="27" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="32" Height="32"><Rectangle Canvas.Left="2" Canvas.Top="4" Width="25" Height="21" RadiusX="3" RadiusY="3" Stroke="#BCD5FA" StrokeThickness="1.7"/><Path Data="M 2,10 L 27,10" Stroke="#BCD5FA" StrokeThickness="1.5"/><Ellipse Canvas.Left="5" Canvas.Top="6.5" Width="1.5" Height="1.5" Fill="#71ABFF"/><Ellipse Canvas.Left="8" Canvas.Top="6.5" Width="1.5" Height="1.5" Fill="#71ABFF"/><Ellipse Canvas.Left="14" Canvas.Top="14" Width="10" Height="10" Fill="#1A2A42" Stroke="#71ABFF" StrokeThickness="2"/><Path Data="M 23,23 L 29,29" Stroke="#71ABFF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Border><StackPanel Margin="13,0,0,0"><TextBlock Text="Aktive Suchen" Foreground="#B7C5D8" FontWeight="SemiBold"/><TextBlock x:Name="ActiveSearchText" Text="0 von 0" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock x:Name="BrowserModeText" Text="Edge-Status" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></StackPanel></Border></Grid>
   <Border x:Name="NewSearchPanel" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource Surface}" BorderBrush="#3D6599" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="155"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="SUCH-URL" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="UrlBox"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="NAME (OPTIONAL)" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="SEKUNDEN" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="IntervalBox" Text="60"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="TREFFER" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5"/><ComboBox x:Name="MatchModeBox" SelectedIndex="1"><ComboBoxItem Content="Nur Titel" Tag="title"/><ComboBoxItem Content="Titel oder Inhalt" Tag="title_or_content"/></ComboBox></StackPanel><Button Grid.Column="4" Content="Hinzufügen" Style="{StaticResource PrimaryButton}" Click="AddSearch_Click" VerticalAlignment="Bottom"/></Grid></Border>

   <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="275"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="4,0,4,12"><StackPanel><TextBlock Text="Suchen" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Deine automatisierten Marktsuchen im Überblick." Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#62A5FF"><Hyperlink NavigateUri="https://www.willhaben.at" RequestNavigate="PlatformLink_Click">Willhaben</Hyperlink><Run Text=" · "/><Hyperlink NavigateUri="https://www.kleinanzeigen.de" RequestNavigate="PlatformLink_Click">Kleinanzeigen</Hyperlink><Run Text=" · "/><Hyperlink NavigateUri="https://www.vinted.at" RequestNavigate="PlatformLink_Click">Vinted</Hyperlink></TextBlock></Grid>
     <ListBox Grid.Row="1" x:Name="SearchGrid" ItemsSource="{Binding Searches}" Background="Transparent" Foreground="#F1F5FB" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border BorderBrush="#3A4B62" BorderThickness="0,1,0,0" Padding="3,12,0,9" Margin="0,5,0,3"><TextBlock Text="{Binding Name}" Foreground="#91A2B9" FontSize="12" FontWeight="SemiBold"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F1F5FB"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="#182432" BorderBrush="#304156" BorderThickness="1" CornerRadius="11" Padding="15"><ContentPresenter/></Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.5"/></DataTrigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#4B8FFF"/><Setter TargetName="Card" Property="Background" Value="#1B2B40"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#1C2A3A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="{Binding SearchNumber}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#F1F5FB"/><Border Grid.Column="1" Height="50" Background="#F3F7FA" CornerRadius="10" Padding="10,7" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="{Binding PortalLogoPath}" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Platform}" Foreground="#19324C" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="7,0,0,0" TextTrimming="CharacterEllipsis"/></Grid></Border><StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,12,0"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#F1F5FB" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding MatchModeLabel}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,9"/><StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="16"/><TextBlock Text="{Binding IntervalLabel}" Margin="7,1,22,0"/><TextBlock Text="♙" FontSize="16"/><TextBlock Text="{Binding RecipientsLabel}" Margin="7,1,0,0"/></StackPanel></StackPanel><StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0"><StackPanel Orientation="Horizontal"><CheckBox IsChecked="{Binding Enabled}" Style="{StaticResource ToggleSwitch}"/><TextBlock Margin="10,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Pausiert"/><Setter Property="Foreground" Value="#AAB8CA"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="True"><Setter Property="Text" Value="Aktiv"/><Setter Property="Foreground" Value="#66E99D"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><TextBlock Text="Letzte Prüfung" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,10,0,2"/><TextBlock Text="{Binding LastRunLabel}" Foreground="#F1F5FB"/></StackPanel><StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="⌕" ToolTip="Jetzt prüfen" Style="{StaticResource IconButton}" Margin="3" Click="CardRun_Click"/><Button Content="Ⅱ" ToolTip="Pausieren / fortsetzen" Style="{StaticResource IconButton}" Margin="3" Click="CardToggle_Click"/><Button Content="♙" ToolTip="Empfänger" Style="{StaticResource IconButton}" Margin="3" Click="CardRecipients_Click"/><Button ToolTip="Weitere Aktionen" Style="{StaticResource IconButton}" Margin="3" Click="CardMore_Click"><StackPanel Orientation="Horizontal"><Ellipse Width="4" Height="4" Fill="#D7E4F5" Margin="2"/><Ellipse Width="4" Height="4" Fill="#D7E4F5" Margin="2"/><Ellipse Width="4" Height="4" Fill="#D7E4F5" Margin="2"/></StackPanel></Button></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <Grid Grid.Row="2" Margin="0,5,0,0"><StackPanel Orientation="Horizontal"><Button Content="Jetzt prüfen" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="RunNow_Click"/><Button Content="Pause / Fortsetzen" Style="{StaticResource RoundedButton}" Margin="0,0,8,0" Click="Toggle_Click"/><Button Content="Empfänger" Style="{StaticResource RoundedButton}" Margin="0,0,8,0" Click="AssignRecipients_Click"/><Button Content="Löschen" Style="{StaticResource RoundedButton}" Foreground="#FF8797" Click="Delete_Click"/></StackPanel></Grid>
    </Grid></Border>
     <StackPanel Grid.Column="1"><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="17"><StackPanel><TextBlock Text="Systemstatus" FontSize="18" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,16,0,14"><Ellipse Width="13" Height="13" Fill="#39DE84"/><TextBlock Text="Agent läuft" Foreground="#62E99A" FontSize="16" FontWeight="SemiBold" Margin="10,-4,0,0"/></StackPanel><Separator Background="#2A394C"/><TextBlock Text="LETZTE PRÜFUNG" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,14,0,4"/><TextBlock x:Name="SystemLastRunText" Text="–"/><TextBlock Text="GESAMTANGEBOTE" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,14,0,4"/><TextBlock x:Name="SystemOffersText" Text="0 gespeicherte Treffer"/><TextBlock Text="ERFOLGREICH GEMELDET" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,14,0,4"/><TextBlock x:Name="SystemNotificationsText" Text="0 Treffer"/><TextBlock Text="FEHLER" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,14,0,4"/><TextBlock x:Name="SystemErrorsText" Text="0" Foreground="#66E99D"/></StackPanel></Border><Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,14,0,0"><StackPanel><TextBlock Text="Schnellzugriff" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/><Button Content="⌕  Neue Suche hinzufügen" Style="{StaticResource RoundedButton}" HorizontalContentAlignment="Left" Margin="0,3" Click="ShowNewSearch_Click"/><Button Content="♙  Empfänger verwalten" Style="{StaticResource RoundedButton}" HorizontalContentAlignment="Left" Margin="0,3" Click="Recipients_Click"/><Button Content="⚙  Einstellungen öffnen" Style="{StaticResource RoundedButton}" HorizontalContentAlignment="Left" Margin="0,3" Click="Email_Click"/><CheckBox x:Name="AutoStartBox" Content="Windows-Autostart" Foreground="#C5D1E2" Margin="5,13,0,3" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/><Button Content="Edge-Profil öffnen" Style="{StaticResource RoundedButton}" Margin="0,5,0,0" Click="OpenProfile_Click"/></StackPanel></Border></StackPanel>
   </Grid>
   <Border Grid.Row="4" Background="#080E17" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,14,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="Aktivitätsprotokoll" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="chronologisch · neueste Meldung unten" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid><ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="#72B7FF" FontFamily="Cascadia Mono,Consolas" FontSize="12" Margin="0,9,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
