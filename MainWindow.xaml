<Window x:Class="MarketWatcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MarketWatcher" Height="820" Width="1320" MinHeight="680" MinWidth="1040" WindowStartupLocation="CenterScreen" Background="#0A0F1A">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#111927"/><SolidColorBrush x:Key="Panel2" Color="#162131"/><SolidColorBrush x:Key="Line" Color="#26364B"/><SolidColorBrush x:Key="Muted" Color="#91A1B7"/><SolidColorBrush x:Key="Blue" Color="#3478F6"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F0F5FC"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0D1522"/><Setter Property="Foreground" Value="White"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#2A3B52"/><Setter Property="Padding" Value="11,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#0D1522"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2A3B52"/><Setter Property="Padding" Value="8"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Background" Value="#3478F6"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}"><Setter Property="Background" Value="#1B283A"/><Setter Property="BorderBrush" Value="#30445F"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style x:Key="NavButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#BBC8DA"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="16,13"/><Setter Property="Margin" Value="8,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <Border Grid.Column="0" Background="#101827" BorderBrush="#243247" BorderThickness="0,0,1,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="16,18,12,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="BrandPanel" Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="12" Background="#173A68"><TextBlock Text="⌕" FontSize="30" Foreground="#52A7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="11,2,0,0"><TextBlock Text="MarketWatcher" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Findet. Informiert." Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel>
     <Button Grid.Column="1" x:Name="CollapseButton" Content="‹" Width="30" Height="30" Style="{StaticResource QuietButton}" Padding="0" Click="CollapseSidebar_Click" ToolTip="Navigation einklappen"/>
    </Grid>
    <StackPanel Grid.Row="1">
     <Button Style="{StaticResource NavButton}" Click="Overview_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="21" Width="34"/><TextBlock x:Name="OverviewNavText" Text="Übersicht" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Click="Searches_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌕" FontSize="21" Width="34"/><TextBlock x:Name="SearchesNavText" Text="Suchen" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Click="Recipients_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="♙" FontSize="21" Width="34"/><TextBlock x:Name="RecipientsNavText" Text="Empfänger" VerticalAlignment="Center"/></StackPanel></Button>
     <Button Style="{StaticResource NavButton}" Click="Email_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="19" Width="34"/><TextBlock x:Name="SettingsNavText" Text="Einstellungen" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="18,12,18,22"><Border Background="#122A25" CornerRadius="10" Padding="10"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="#36D980" Margin="0,0,9,0"/><TextBlock x:Name="SidebarAgentText" Text="Agent läuft" Foreground="#6BE5A0"/></StackPanel></Border><TextBlock x:Name="SidebarVersionText" Text="MarketWatcher · lokal" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,10,0,0"/><TextBlock x:Name="CopyrightText" Text="© Michael P. Thiess" Foreground="#718299" FontSize="10" Margin="2,5,0,0"/><TextBlock x:Name="GithubText" FontSize="10" Margin="2,3,0,0"><Hyperlink NavigateUri="https://github.com/therepro21/marketwatcher" RequestNavigate="PlatformLink_Click">GitHub · MarketWatcher</Hyperlink></TextBlock></StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Column="1" Margin="24,18,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="185"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="MarketWatcher" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="Deine automatisierten Marktsuchen im Überblick" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="＋ Neue Suche hinzufügen" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="ShowNewSearch_Click"/><Button Content="⚙ Einstellungen" Style="{StaticResource QuietButton}" Click="Email_Click"/></StackPanel>
   </Grid>

   <Grid Grid.Row="1" Margin="0,18,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,10,0"><StackPanel><TextBlock Text="●  AGENTSTATUS" Foreground="#6BE5A0" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="AgentStatus" Text="Agent wird gestartet" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="Überwachung im Hintergrund" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
    <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="5,0"><StackPanel><TextBlock Text="◷  NÄCHSTE PRÜFUNG" Foreground="#8BAEFF" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="NextCheckText" Text="Wird berechnet …" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock Text="nach gespeichertem Intervall" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
    <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="16" Margin="10,0,0,0"><StackPanel><TextBlock Text="▱  AKTIVE SUCHEN" Foreground="#8BAEFF" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="ActiveSearchText" Text="0 von 0" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,2"/><TextBlock x:Name="BrowserModeText" Text="Edge wird bedarfsgerecht gestartet" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
   </Grid>

   <Border x:Name="NewSearchPanel" Grid.Row="2" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="#315280" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="155"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="SUCH-URL" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="UrlBox"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="NAME (OPTIONAL)" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="SEKUNDEN" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5"/><TextBox x:Name="IntervalBox" Text="60"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="TREFFER" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5"/><ComboBox x:Name="MatchModeBox" SelectedIndex="1"><ComboBoxItem Content="Nur Titel" Tag="title"/><ComboBoxItem Content="Titel oder Inhalt" Tag="title_or_content"/></ComboBox></StackPanel><Button Grid.Column="4" Content="Hinzufügen" Style="{StaticResource PrimaryButton}" Click="AddSearch_Click" VerticalAlignment="Bottom"/></Grid></Border>

   <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="4,0,4,12"><TextBlock Text="Suchen" FontSize="19" FontWeight="SemiBold"/><TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}"><Hyperlink NavigateUri="https://www.willhaben.at" RequestNavigate="PlatformLink_Click">Willhaben</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.kleinanzeigen.de" RequestNavigate="PlatformLink_Click">Kleinanzeigen</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.vinted.at" RequestNavigate="PlatformLink_Click">Vinted</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.markt.de" RequestNavigate="PlatformLink_Click">markt.de</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.quoka.de" RequestNavigate="PlatformLink_Click">Quoka</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.tutti.ch" RequestNavigate="PlatformLink_Click">Tutti</Hyperlink></TextBlock></Grid>
    <ListBox Grid.Row="1" x:Name="SearchGrid" ItemsSource="{Binding Searches}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Selection" Background="#151F2E" BorderBrush="#2A3A50" BorderThickness="1" CornerRadius="10" Padding="13"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Selection" Property="BorderBrush" Value="#478BFF"/><Setter TargetName="Selection" Property="Background" Value="#192A42"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Selection" Property="Background" Value="#192536"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="105"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="105"/><ColumnDefinition Width="110"/><ColumnDefinition Width="165"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding SearchNumber}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Border Grid.Column="1" Background="#23354C" CornerRadius="7" Padding="9,6" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Platform}" Foreground="#A9CCFF" FontWeight="SemiBold"/></Border>
      <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,12,0"/></StackPanel>
      <StackPanel Grid.Column="3" VerticalAlignment="Center"><TextBlock Text="Intervall" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding IntervalLabel}" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="4" VerticalAlignment="Center"><TextBlock Text="Empfänger" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding RecipientsLabel}" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="5" VerticalAlignment="Center"><TextBlock Text="Letzte Prüfung" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="{Binding LastRunLabel}" Margin="0,4,0,0"/></StackPanel>
      <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="▶" ToolTip="Jetzt prüfen" Style="{StaticResource QuietButton}" Padding="10,7" Margin="2" Click="CardRun_Click"/><Button Content="Ⅱ" ToolTip="Pausieren / fortsetzen" Style="{StaticResource QuietButton}" Padding="10,7" Margin="2" Click="CardToggle_Click"/><Button Content="♙" ToolTip="Empfänger" Style="{StaticResource QuietButton}" Padding="10,7" Margin="2" Click="CardRecipients_Click"/></StackPanel>
     </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Grid Grid.Row="2" Margin="0,5,0,0"><StackPanel Orientation="Horizontal"><Button Content="Jetzt prüfen" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="RunNow_Click"/><Button Content="Pause / Fortsetzen" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="Toggle_Click"/><Button Content="Empfänger" Style="{StaticResource QuietButton}" Margin="0,0,8,0" Click="AssignRecipients_Click"/><Button Content="Löschen" Style="{StaticResource QuietButton}" Foreground="#FF8A98" Click="Delete_Click"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox x:Name="AutoStartBox" Content="Windows-Autostart" Foreground="#C5D1E2" VerticalAlignment="Center" Margin="0,0,12,0" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/><Button Content="Edge-Profil öffnen" Style="{StaticResource QuietButton}" Click="OpenProfile_Click"/></StackPanel></Grid>
   </Grid></Border>

   <Border Grid.Row="4" Background="#080E18" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,14,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="Aktivitätsprotokoll" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="chronologisch · neueste Meldung unten" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid><ListBox Grid.Row="1" x:Name="LogList" ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="#83BFFF" FontFamily="Consolas" FontSize="12" Margin="0,9,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Grid></Border>
  </Grid>
 </Grid>
</Window>
