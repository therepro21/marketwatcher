<Window x:Class="MarketWatcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MarketWatcher" Height="750" Width="1160" MinHeight="620" MinWidth="950" WindowStartupLocation="CenterScreen" Background="#0B1020">
 <Window.Resources>
  <SolidColorBrush x:Key="Card" Color="#141B2D"/><SolidColorBrush x:Key="Muted" Color="#93A4BF"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0FF"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1526"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2B3A58"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#5468FF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#141B2D"/><Setter Property="Foreground" Value="#EAF0FF"/><Setter Property="RowBackground" Value="#141B2D"/><Setter Property="AlternatingRowBackground" Value="#182238"/><Setter Property="BorderBrush" Value="#2B3A58"/><Setter Property="GridLinesVisibility" Value="Horizontal"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#0E1526"/><Setter Property="Foreground" Value="#AFC0DC"/><Setter Property="Padding" Value="8"/></Style>
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MarketWatcher" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Lokaler Suchagent · Edge-Profil · dauerhafte Ausschlussliste" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock HorizontalAlignment="Right" Margin="0,0,0,8"><Hyperlink NavigateUri="https://www.willhaben.at" RequestNavigate="PlatformLink_Click">Willhaben</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.kleinanzeigen.de" RequestNavigate="PlatformLink_Click">Kleinanzeigen</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.vinted.at" RequestNavigate="PlatformLink_Click">Vinted</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.ebay.at" RequestNavigate="PlatformLink_Click">eBay.at</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.ebay.de" RequestNavigate="PlatformLink_Click">eBay.de</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.markt.de" RequestNavigate="PlatformLink_Click">markt.de</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.quoka.de" RequestNavigate="PlatformLink_Click">Quoka</Hyperlink><Run Text="  ·  "/><Hyperlink NavigateUri="https://www.tutti.ch" RequestNavigate="PlatformLink_Click">Tutti</Hyperlink></TextBlock><Border Background="#17243A" CornerRadius="18" Padding="14,7" HorizontalAlignment="Right"><TextBlock x:Name="AgentStatus" Text="● Agent wird gestartet" Foreground="#7CE7B2"/></Border></StackPanel></Grid>
  <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="12" Padding="18" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="85"/><ColumnDefinition Width="155"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="SUCH-URL" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="UrlBox"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="NAME (OPTIONAL)" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="NameBox"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="SEKUNDEN" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="IntervalBox" Text="60"/></StackPanel><StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="TREFFER" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6"/><ComboBox x:Name="MatchModeBox" SelectedIndex="1" Padding="7"><ComboBoxItem Content="Nur Titel" Tag="title"/><ComboBoxItem Content="Titel oder Inhalt" Tag="title_or_content"/></ComboBox></StackPanel><Button Grid.Column="4" Content="Suche hinzufügen" Click="AddSearch_Click" VerticalAlignment="Bottom"/></Grid></Border>
  <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="12" Padding="12"><DataGrid x:Name="SearchGrid" ItemsSource="{Binding Searches}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled}" Width="55"/><DataGridTextColumn Header="Suche" Binding="{Binding Name}" Width="175"/><DataGridTextColumn Header="Plattform" Binding="{Binding Platform}" Width="90"/><DataGridTextColumn Header="Treffer" Binding="{Binding MatchModeLabel}" Width="120"/><DataGridTextColumn Header="Empfänger" Binding="{Binding RecipientsLabel}" Width="90"/><DataGridTextColumn Header="Intervall" Binding="{Binding IntervalLabel}" Width="70"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Letzter Lauf" Binding="{Binding LastRunLabel}" Width="130"/><DataGridTextColumn Header="Ausschlussliste" Binding="{Binding SeenCount}" Width="100"/></DataGrid.Columns></DataGrid></Border>
  <Grid Grid.Row="3" Margin="0,12"><StackPanel Orientation="Horizontal"><Button Content="Jetzt prüfen" Click="RunNow_Click"/><Button Content="Suche pausieren / fortsetzen" Click="Toggle_Click" Background="#263451"/><Button Content="Empfänger zuordnen" Click="AssignRecipients_Click" Background="#263451"/><Button Content="Löschen" Click="Delete_Click" Background="#71364A"/><Button Content="⚙ Einstellungen" Click="Email_Click" Background="#263451"/><Button Content="Edge-Profil öffnen" Click="OpenProfile_Click" Background="#263451"/></StackPanel><CheckBox x:Name="AutoStartBox" Content="Mit Windows starten (nur im Tray)" Foreground="#D9E5FA" VerticalAlignment="Center" HorizontalAlignment="Right" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/></Grid>
  <Border Grid.Row="4" Background="#080D19" CornerRadius="10" Padding="12"><ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0" Foreground="#9FB0CC" FontFamily="Consolas" FontSize="12"/></Border>
 </Grid>
</Window>
